[application]

config/name="card_game"
run/main_scene="res://duel_fieldv2023_11_15.tscn"
boot_splash/fullsize=false

[display]

window/size/borderless=true
window/vsync/use_vsync=false
window/energy_saving/keep_screen_on=false
window/handheld/orientation="sensor_landscape"
window/stretch/mode="2d"

[editor_plugins]

enabled=PoolStringArray( "res://addons/KOBUGE-games.CircularContainer/plugin.cfg", "res://addons/Trail/plugin.cfg", "res://addons/array_modifier/plugin.cfg", "res://addons/godot-sqlite/plugin.cfg" )

[importer_defaults]

texture={
"flags/anisotropic": true,
"flags/mipmaps": true
}

[physics]

common/enable_pause_aware_picking=true

[rendering]

quality/driver/driver_name="GLES2"
vram_compression/import_etc=true
vram_compression/import_etc2=false
quality/filters/anisotropic_filter_level=16
quality/filters/msaa=4
quality/filters/use_fxaa=true
environment/default_environment="res://default_env.tres"
